# Copy this file to .env before starting the project. Never commit .env.
POSTGRES_DB=legal_master
POSTGRES_USER=legal_master
POSTGRES_PASSWORD=change-this-local-password

DATABASE_URL=postgresql+asyncpg://legal_master:change-this-local-password@postgres:5432/legal_master
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# Use a long, random value outside local development.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

STORAGE_PATH=/data/documents
MAX_UPLOAD_SIZE_MB=25
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000
