# Copy this file to .env before starting the project. Never commit .env.
POSTGRES_DB=legal_master
POSTGRES_USER=legal_master
POSTGRES_PASSWORD=change-this-local-password

DATABASE_URL=postgresql+asyncpg://legal_master:change-this-local-password@postgres:5432/legal_master
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_master_document_chunks
QDRANT_TIMEOUT_SECONDS=30
QDRANT_UPSERT_BATCH_SIZE=64

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-small-en
EMBEDDING_DIMENSION=512
EMBEDDING_CACHE_PATH=/data/models
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENCY=1
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHUNK_MIN_SIZE=100

# Use a long, random value outside local development.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Private backend-only original document storage. Default limit: 50 MiB.
DOCUMENT_STORAGE_PATH=/data/documents
DOCUMENT_MAX_SIZE_BYTES=52428800

# Local PDF OCR fallback. The Docker image installs only the English language pack.
OCR_ENABLED=true
OCR_LANG=eng
OCR_DPI=200
OCR_MAX_PAGES=100
OCR_TIMEOUT_SECONDS=120
OCR_MAX_IMAGE_PIXELS=25000000
OCR_MAX_CONCURRENCY=1
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
# Optional. When empty, the frontend uses its current hostname with port 8000.
VITE_API_BASE_URL=
